[Unit]
Description=Hermes Studio local web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/hermes-studio/environment
ExecStart=%h/.local/bin/hermes-studio-web
Restart=on-failure
RestartSec=3s
SuccessExitStatus=143
KillMode=mixed
TimeoutStopSec=5min
UMask=0077

[Install]
WantedBy=default.target
