# Runtime project data stays out of git. Repo structure is preserved by .gitkeep.
studio-root/projects/*
!studio-root/projects/.gitkeep
studio-root/tmp/*
!*/.gitkeep
__pycache__/
*.pyc
.venv/
.runtime/
.env
.env.*
!.env.example
hermes/profiles/*/config.yaml
*.pem
*.key
id_rsa*
credentials.json
secrets.json
*.db
*.sqlite
*.sqlite3
*.log
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
node_modules/
dist/
build/
coverage/
.coverage
.idea/
.vscode/
