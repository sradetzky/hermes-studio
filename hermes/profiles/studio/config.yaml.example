# Example config snippet for the studio profile.
# After `hermes profile create studio --clone`, edit the real config.yaml
# and point the model at your shared local OpenAI-compatible endpoint.

model:
  # Keep this the same across main + studio + any other profiles
  # so you can switch models by only restarting the local server.
  provider: custom
  default: "your-local-model-name"
  base_url: "http://127.0.0.1:8000/v1"  # or your OpenAI-compatible endpoint

# Optional: restrict tools / enable the design-studio skill explicitly
# skills:
#   - design-studio

# Production ComfyUI transport (Studio orchestrator only).
mcp_servers:
  comfyui:
    command: "npx"
    args: ["-y", "comfyui-mcp@0.52.61"]
    env:
      COMFYUI_URL: "http://127.0.0.1:8188"
      COMFYUI_PATH: "/home/sven/ComfyUI"
      COMFYUI_PYTHON: "/home/sven/ComfyUI/.venv/bin/python"
    connect_timeout: 120
    enabled: true